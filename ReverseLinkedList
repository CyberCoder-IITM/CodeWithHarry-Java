/**
 * A package for linked list algorithms.
 */
package com.algorithms.linkedlists;

/**
 * Solves the "Reverse a Linked List" problem.
 *
 * This class provides an iterative method to reverse a singly linked list.
 * It also includes a main method for testing the solution.
 *
 * @author Saleeq (CyberCoder-IITM)
 */
public class ReverseLinkedList {

    /**
     * Definition for a singly-linked list node.
     * This is a static inner class so it can be accessed by main.
     */
    public static class ListNode {
        int val;
        ListNode next;

        ListNode(int val) {
            this.val = val;
        }

        ListNode(int val, ListNode next) {
            this.val = val;
            this.next = next;
        }
    }

    /**
     * Reverses a singly-linked list iteratively.
     *
     * This method iterates through the list, changing the 'next' pointer
     * of each node to point to the previous node.
     *
     * Time Complexity: O(n) - We visit each node once.
     * Space Complexity: O(1) - We only use three-pointer variables.
     *
     * @param head The head of the original linked list.
     * @return The new head of the reversed linked list.
     */
    public ListNode reverseList(ListNode head) {
        // 'prev' will store the new head (which starts as null).
        ListNode prev = null; 
        
        // 'current' starts at the beginning of the list.
        ListNode current = head; 

        // We also need a 'nextTemp' to temporarily hold the next node.
        ListNode nextTemp = null; 

        // Loop until we've processed every node
        while (current != null) {
            // 1. Store the next node before we overwrite current.next
            nextTemp = current.next;

            // 2. This is the reversal: point the current node's 'next' to the 'prev' node.
            current.next = prev;

            // 3. Move the pointers one step forward for the next iteration.
            // 'prev' becomes the node we just processed.
            prev = current; 
            // 'current' becomes the next node we stored in step 1.
            current = nextTemp; 
        }

        // When the loop ends, 'current' is null, and 'prev' is the last node
        // we processed, which is the new head of the reversed list.
        return prev;
    }

    /**
     * Main method to test the reverseList solution.
     * @param args Command line arguments (not used).
     */
    public static void main(String[] args) {
        ReverseLinkedList reverser = new ReverseLinkedList();

        // --- Test Case 1 ---
        // Create a list: 1 -> 2 -> 3 -> 4 -> 5 -> NULL
        ListNode head1 = new ListNode(1);
        head1.next = new ListNode(2);
        head1.next.next = new ListNode(3);
        head1.next.next.next = new ListNode(4);
        head1.next.next.next.next = new ListNode(5);

        System.out.println("--- Linked List Reversal ---");
        System.out.println("Original List 1:");
        printList(head1); // Helper method to print the list

        // Reverse the list
        ListNode reversedHead1 = reverser.reverseList(head1);

        System.out.println("\nReversed List 1:");
        printList(reversedHead1); // Should print: 5 -> 4 -> 3 -> 2 -> 1
        System.out.println("------------------------------------");

        // --- Test Case 2 ---
        // Create a list: 1 -> 2 -> NULL
        ListNode head2 = new ListNode(1);
        head2.next = new ListNode(2);

        System.out.println("Original List 2:");
        printList(head2);

        ListNode reversedHead2 = reverser.reverseList(head2);

        System.out.println("\nReversed List 2:");
        printList(reversedHead2); // Should print: 2 -> 1
        System.out.println("------------------------------------");

        // --- Test Case 3: Empty List ---
        ListNode head3 = null;
        System.out.println("Original List 3 (Empty):");
        printList(head3);
        
        ListNode reversedHead3 = reverser.reverseList(head3);
        
        System.out.println("\nReversed List 3 (Empty):");
        printList(reversedHead3); // Should print: NULL
        System.out.println("------------------------------------");
    }

    /**
     * A utility helper method to print a linked list.
     * @param head The head of the list to print.
     */
    public static void printList(ListNode head) {
        if (head == null) {
            System.out.println("NULL");
            return;
        }

        ListNode current = head;
        while (current != null) {
            System.out.print(current.val + " -> ");
            current = current.next;
        }
        System.out.println("NULL");
    }
}